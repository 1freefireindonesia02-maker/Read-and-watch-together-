# ==============================
# Watch/Read Together — .env
# ==============================

# MongoDB connection string
# Local:  mongodb://localhost:27017/watchreadtogether
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/watchreadtogether
MONGODB_URI=mongodb://localhost:27017/watchreadtogether

# Session secret — change this to a long random string!
SESSION_SECRET=change-this-to-a-long-random-secret-string-minimum-32-chars

# Your full domain (no trailing slash)
# Local:      http://localhost:3000
# Production: https://yourdomain.com
BASE_URL=http://localhost:3000

# Port to run server on
PORT=3000

# ---- Google OAuth (Optional) ----
# 1. Go to: https://console.cloud.google.com
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized redirect URI: BASE_URL/auth/google/callback
# Leave blank to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
