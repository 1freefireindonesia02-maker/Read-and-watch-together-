# ═══════════════════════════════════════════════════════════════
#  WATCH/READ TOGETHER — Environment Variables
#  Copy this file to .env and fill in your values
#  Command: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── MONGODB ─────────────────────────────────────────────────────
# Option A: Local MongoDB
#   MONGODB_URI=mongodb://localhost:27017/watchreadtogether
#
# Option B: MongoDB Atlas FREE Cloud (Recommended for deployment)
#   1. cloud.mongodb.com → Free account
#   2. Build Cluster → Free tier M0
#   3. Create DB user (save username + password)
#   4. Network Access → 0.0.0.0/0
#   5. Connect → Drivers → copy string → replace <user> <pass>
#
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/watchreadtogether

# ── SESSION SECRET ───────────────────────────────────────────────
# Long random string — MUST change before deploying!
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
SESSION_SECRET=change-this-to-a-very-long-random-secret-string

# ── BASE URL ─────────────────────────────────────────────────────
# No trailing slash!
# Local:      http://localhost:3000
# Render:     https://your-app.onrender.com
#
BASE_URL=http://localhost:3000

# ── PORT ─────────────────────────────────────────────────────────
PORT=3000

# ── GOOGLE OAUTH (Optional) ──────────────────────────────────────
# Leave blank to disable Google login button automatically
#
# Setup:
#   1. console.cloud.google.com → New Project
#   2. APIs & Services → Credentials → OAuth 2.0 Client ID
#   3. Web application type
#   4. Authorized redirect URIs:
#      http://localhost:3000/auth/google/callback
#      https://your-app.onrender.com/auth/google/callback
#   5. Copy Client ID and Secret below
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── FILE UPLOAD ───────────────────────────────────────────────────
MAX_PDF_SIZE_MB=150
PDF_DELETE_HOURS=24
